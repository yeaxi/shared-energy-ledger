{
  "name": "shared-energy-ledger",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Companion Lovelace card bundle for the shared_energy_ledger Home Assistant custom integration.",
  "license": "MIT",
  "scripts": {
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "build": "npm run build:report",
    "build:report": "CARD_ENTRY=shared-energy-ledger-report vite build"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vite": "^5.4.0",
    "eslint": "^9.9.0",
    "@typescript-eslint/parser": "^8.6.0",
    "@typescript-eslint/eslint-plugin": "^8.6.0",
    "@types/node": "^20.14.0",
    "vitest": "^2.0.0",
    "@vitest/coverage-v8": "^2.0.0"
  }
}
